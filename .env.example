# ==========================================
# Zepp Life (原小米运动) 自动刷步数环境变量配置文件模板
# 使用方法：复制本文件重命名为 .env，并填入你的实际配置
# ==========================================

# 1. 账号与密码（必填）
# 支持单个账号，或多个账号用 # 分隔（例如：13800000000#abc@qq.com）
USER=13800000000
PWD=your_password

# 2. 步数随机范围设置（选填，默认 18000 ~ 25000）
MIN_STEP=18000
MAX_STEP=25000

# 3. 本地加密密钥（选填）
# 建议配置 16 位字符串密钥，用于保存和加密 Token 及已绑定设备 ID，加速后续登录
AES_KEY=1234567890123456

# 3.1 虚拟设备自动绑定（选填）
# 当账号未绑定任何小米手环/手表时，程序会自动调用第三方接口为其绑定一台虚拟设备后再上传步数。
# 已内置默认 API Key，通常无需修改；如需更换可在此覆盖。
# BIND_API_KEY=505dde-8f66a3-62ddc8-9de109
# 自定义虚拟设备显示名（6 字以内，可选）
# BIND_DEVICE_NAME=Mi手环


# 4. 多账号执行配置（选填）
SLEEP_GAP=5
USE_CONCURRENT=False

# 5. 推送服务通知配置（选填）
# PushPlus 推送配置
PUSH_PLUS_TOKEN=
PUSH_PLUS_HOUR=
PUSH_PLUS_MAX=30

# 企业微信 Webhook 机器人推送配置
PUSH_WECHAT_WEBHOOK_KEY=

# Telegram Bot 推送配置
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 6. JSON 格式全量配置（选填）
# GitHub Actions 环境中使用的 CONFIG 变量范例
# CONFIG='{"USER": "13800000000", "PWD": "your_password", "MIN_STEP": "18000", "MAX_STEP": "25000"}'
